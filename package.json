{
  "name": "radium",
  "author": "alkalines",
  "version": "dev",
  "private": true,
  "workspaces": ["packages/*", "apps/*"],
  "homepage": "https://github.com/alkalines/Radium#readme",
  "bugs": {
    "url": "https://github.com/alkalines/Radium/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alkalines/Radium.git"
  },
  "scripts": {
    "dev": "concurrently -c magenta,yellow --names vite-dev,convex-dev \"bun --cwd apps/web dev --clearScreen false\" \"bun --cwd packages/backend run dev\"",
    "lint": "eslint",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}

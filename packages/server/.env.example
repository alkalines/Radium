# Backend runtime configuration (src/config.ts). Copy to `.env` for `bun run dev`.

# Web origin (cookies, auth origin checks, reset links) and the backend's public origin
# (Gateway base URL, Worker token issuer). HTTPS, or http on localhost.
SITE_URL=http://localhost:3000
API_URL=http://localhost:3100

# Direct connections; see docker-compose.yml for the local services.
DATABASE_URL=postgres://radium:<POSTGRES_PASSWORD>@127.0.0.1:5432/radium
VALKEY_URL=redis://127.0.0.1:6379

# Must equal the Convex deployment's values when importing it, or sessions and OPAQUE logins
# stop working. New install: `openssl rand -base64 32` and `bunx better-auth-opaque create-setup`.
BETTER_AUTH_SECRET=
OPAQUE_SERVER_SETUP=

# Optional. Shared with the web server so per-address auth rate limits see the real client.
AUTH_PROXY_SECRET=
# Optional. Public issuer keys for Worker access tokens (JSON JWKS); without it every Worker call
# is refused.
WORKER_AUTH_JWKS=

# Secret Store key-encryption keys, `version:base64,…` (each `openssl rand -base64 32`); the
# highest version encrypts new secrets. Must equal the Convex deployment's values when importing.
SECRET_STORE_KEYS=
# Optional. Base64url 32-byte key for workspace-scoped fingerprints (session-affinity hashes,
# telemetry content hashes); without it both are off. Must equal the Convex value when importing.
TELEMETRY_HASH_SECRET=
# Optional. Signs the Login with ChatGPT session cookie; without it the ChatGPT subscription
# routes answer 503. Must equal the Convex value for connected accounts to keep working.
LWC_SECRET=

# Object store for chat attachments: exactly one of an S3-compatible bucket (Bun's S3 variable
# names; set S3_ENDPOINT for MinIO, R2, Garage) or a local directory on a single-node install.
FILES_DIR=./files
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_SESSION_TOKEN=
# S3_REGION=
# S3_ENDPOINT=

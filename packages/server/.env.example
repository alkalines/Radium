# Server runtime configuration. Copy to packages/server/.env for development.
# The defaults match compose.dev.yml at the repository root.
# Listening port of `bun run start`/`start:node` (`bun run dev` always uses 3001).
PORT=3001
DATABASE_URL="postgres://radium:radium@localhost:5432/radium"
VALKEY_URL="redis://localhost:6379"

# Tests use their own database (created by compose.dev.yml) and key prefixes on the same Valkey.
# TEST_DATABASE_URL="postgres://radium:radium@localhost:5432/radium_test"
# TEST_VALKEY_URL="redis://localhost:6379"

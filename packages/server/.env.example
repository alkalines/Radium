# Backend runtime configuration (src/config.ts). Copy to `.env` for `bun run dev`.

# Web origin (cookies, auth origin checks, reset links) and the backend's public origin
# (Gateway base URL, Worker token issuer). HTTPS, or http on localhost.
SITE_URL=http://localhost:3000
API_URL=http://localhost:3100

# Direct connections; see docker-compose.yml for the local services.
DATABASE_URL=postgres://radium:<POSTGRES_PASSWORD>@127.0.0.1:5432/radium
VALKEY_URL=redis://127.0.0.1:6379

# Must equal the Convex deployment's values when importing it, or sessions and OPAQUE logins
# stop working. New install: `openssl rand -base64 32` and `bunx better-auth-opaque create-setup`.
BETTER_AUTH_SECRET=
OPAQUE_SERVER_SETUP=

# Optional. Shared with the web server so per-address auth rate limits see the real client.
AUTH_PROXY_SECRET=
# Optional. Public issuer keys for Worker access tokens (JSON JWKS); without it every Worker call
# is refused.
WORKER_AUTH_JWKS=

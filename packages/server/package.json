{
  "name": "server",
  "private": true,
  "type": "module",
  "imports": {
    "#drivers": "./src/drivers/bun.ts"
  },
  "exports": {
    "./router": "./src/trpc/router.ts"
  },
  "scripts": {
    "dev": "nitro dev --port 3100",
    "build": "nitro build",
    "start": "bun .output/server/index.mjs",
    "db:generate": "drizzle-kit generate && bun bin/schema-version.ts",
    "db:check": "drizzle-kit check",
    "db:migrate": "bun bin/migrate.ts",
    "auth:schema": "bun --bun x auth generate --config src/auth/schema-config.ts --output src/auth/schema.ts --yes",
    "test": "bun --bun vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@alkalines/better-auth-opaque": "0.2.0",
    "@better-auth/core": "1.7.18",
    "@better-auth/drizzle-adapter": "1.7.18",
    "@hono/trpc-server": "0.4.2",
    "@trpc/server": "11.29.7",
    "better-auth": "1.7.18",
    "contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.6",
    "hono": "^4.13.17",
    "jose": "^6.2.15",
    "nitro": "3.0.261103-rc",
    "radium-crypto": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@serenity-kit/opaque": "1.1.0",
    "@types/bun": "latest",
    "auth": "1.7.18",
    "drizzle-kit": "1.0.0-rc.6",
    "vitest": "^5.1.0"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}

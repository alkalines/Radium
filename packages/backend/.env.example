# Reference for app runtime variables declared in convex/convex.config.ts.
# This file is not loaded automatically into a Convex deployment. Set runtime
# values on the selected deployment with `bunx convex env set` or the dashboard.

# Convex CLI deployment selection is separate and normally stored by the CLI in
# this package's ignored .env.local file. It does not configure runtime values.
# CONVEX_DEPLOYMENT=dev:your-deployment

# Required on the selected Convex deployment.
SITE_URL=http://localhost:3000
SECRET_STORE_KEYS=1:replace-with-a-base64-key
# OPAQUE server key and OPRF seed. Generate ONCE per deployment from packages/backend after
# `bun install`: `bunx better-auth-opaque create-setup`. Back it up with the database (secret
# manager plus offline copy); losing or regenerating it breaks every password, and never commit it.
OPAQUE_SERVER_SETUP=replace-with-create-setup-output

# Recommended when the web app serves /api/auth (its server proxies auth to Convex): a random
# secret shared with the web server (`openssl rand -base64 32`), so auth rate limits apply per
# browser address instead of one bucket for the web server. Set the same value on the web server.
# AUTH_PROXY_SECRET=replace-with-a-random-secret

# Optional: uncomment and replace only when enabling the related feature.
# AISDK_MaxRetries=0
# LWC_SECRET=replace-with-a-locally-generated-secret
# WORKER_AUTH_PRIVATE_JWK=<private JWK JSON>
# WORKER_AUTH_JWKS=<public JWKS JSON>
# Web Push for notifications (`bunx web-push generate-vapid-keys`); subject defaults to SITE_URL.
# WEB_PUSH_VAPID_PUBLIC_KEY=<public key>
# WEB_PUSH_VAPID_PRIVATE_KEY=<private key>
# WEB_PUSH_SUBJECT=mailto:admin@example.com

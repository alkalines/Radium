# Secrets for docker-compose.yml. Copy to `.env` and generate each value, e.g. `openssl rand -hex 32`.
POSTGRES_PASSWORD=
# Bearer token the backend presents to Durable Streams; same value as the backend's STREAMS_TOKEN.
STREAMS_TOKEN=
# Only for the `electric` profile; same value as the backend's ELECTRIC_SECRET.
ELECTRIC_SECRET=

# Host ports (bound to 127.0.0.1); change only on conflict.
# POSTGRES_PORT=5432
# VALKEY_PORT=6379
# STREAMS_PORT=4437
# ELECTRIC_PORT=3001

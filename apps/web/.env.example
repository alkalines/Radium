# Public frontend configuration. Copy to apps/web/.env.local and replace the origins.
# These values are embedded in the browser build; do not put credentials here.
VITE_CONVEX_URL="https://your-deployment.convex.cloud"
VITE_CONVEX_SITE_URL="https://your-deployment.convex.site"

# Enable latest-turn Fork for ACP Sessions when the agent advertises support.
# session/fork is unstable in ACP v1; leave disabled unless you accept that protocol surface.
VITE_ACP_FORK="false"

# Server-only (never VITE_*): lets Convex rate-limit auth requests per real client instead of
# per web server. Must equal AUTH_PROXY_SECRET on the Convex deployment (`openssl rand -hex 32`).
# AUTH_PROXY_SECRET=
# Set to "true" only behind a reverse proxy that overwrites X-Forwarded-For.
# AUTH_TRUST_X_FORWARDED_FOR="false"

# Backend runtime configuration and CLI deployment selection are documented in
# packages/backend/.env.example and docs/deployment.md, not in this frontend file.

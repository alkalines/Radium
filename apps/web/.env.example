# Generated in .env.local by bun run convex:dev
# CONVEX_DEPLOYMENT="dev:your-deployment"
# VITE_CONVEX_URL="https://your-deployment.convex.cloud"
# VITE_CONVEX_SITE_URL="https://your-deployment.convex.site"

# Convex ENVs
SITE_URL="http://localhost:3000"
SECRET_STORE_KEYS="1:<openssl rand -base64 32>"
AISDK_MaxRetries="0" # 0: Disabled
LWC_SECRET="<openssl rand -hex 32>" # Convex env: signs ChatGPT Subscription sessions
# Optional Worker machine auth, Convex runtime only (see docs/Worker/Machine_Authentication.md).
# WORKER_AUTH_PRIVATE_JWK='<private P-256 issuer JWK with kid>'
# WORKER_AUTH_JWKS='{"keys":[<matching public ES256 JWK>]}'
# CONVEX_SITE_URL and CONVEX_CLOUD_URL are supplied by the Convex backend.

# Optional external OpenTelemetry export. Telemetry must also be enabled per user.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://collector.example.com"
# OTEL_EXPORTER_OTLP_HEADERS="Authorization=Bearer <token>"
# OTEL_SERVICE_NAME="radium-gateway"
